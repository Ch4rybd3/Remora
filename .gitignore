# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
.env

# Virtual environments
.venv/
backend/.venv/

# ── Runtime data ──────────────────────────────────────────────────────────────
# data/ holds the SQLite DB, uploaded forensic files, evidence, memory dumps,
# knowledge vaults, note images — none of this should ever be committed.
# `**/` on purpose: a bare `data/*` matches only the repository root, and a
# `backend/data/` - which the backend creates when run from its own directory -
# would be committed. That directory holds evidence.
# Contents are ignored rather than the directory itself, so git still descends
# and the placeholder negations below keep working.
**/data/*
# Allow directory placeholders so the folder structure survives a fresh clone
!**/data/.gitkeep
!**/data/*/.gitkeep

# Default host-side drop folder (DROPZONE_HOST_PATH in .env) — holds the raw
# artifacts analysts drop in, same sensitivity as data/.
/dropzone/

# Default host-side disk image directory (DISK_IMAGES_HOST_PATH in .env) —
# forensic acquisitions, never committed.
/images/

# Databases (belt-and-suspenders in case files escape data/)
*.db
*.db-wal
*.db-shm
*.sqlite

# ── Sample / template content (ALWAYS committed) ──────────────────────────────
# templates/ — case template YAML files shipped with the platform
# samples/   — sample playbooks, demo cases, example vaults
# These directories must remain trackable; do NOT add them here.

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
