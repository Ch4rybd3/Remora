# ═══════════════════════════════════════════════════════════════════════════════
# Remora — Environment Configuration
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Security (REQUIRED) ───────────────────────────────────────────────────────

# JWT signing key — must be a long random string.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# WARNING: changing this after first launch invalidates all existing sessions.
SECRET_KEY=change_me_generate_a_random_hex_key_here

# Password for the default 'admin' account created on first startup.
# Change this before going live. You can change it later via the Users page.
DEFAULT_ADMIN_PASSWORD=change_me_strong_password

# ── Network ───────────────────────────────────────────────────────────────────

# Port to expose on the host machine (default: 80).
# Change to 8080 if port 80 is already in use.
PORT=80

# Network interface to bind on the host machine.
#   0.0.0.0   → accessible from all interfaces (LAN, Wi-Fi, …)  [default]
#   127.0.0.1 → local only (use this when exposing via a Cloudflare tunnel)
BIND_HOST=0.0.0.0

# ── Drop folder ───────────────────────────────────────────────────────────────
# A watched directory with one sub-folder per case. Drop KAPE/EZ Tools output
# in it and Remora ingests it exactly as if it had been uploaded through the
# Collection tab — no browser upload, no size limit.
#
# Host directory bind-mounted into the backend. Leave as-is to keep the drop
# folder inside the Docker volume (then reach it with `docker cp`), or point it
# at a real host path to drop files straight from your file manager:
#   DROPZONE_HOST_PATH=/home/analyst/remora-dropzone
DROPZONE_HOST_PATH=./dropzone

# Ingest automatically as soon as a file stops changing (true), or wait for an
# explicit "Scanner" click in the Collection tab (false).
DROPZONE_AUTO_INGEST=true

# How often the folder is swept, in seconds.
DROPZONE_POLL_SECONDS=30

# A file is only ingested after being untouched this long, so a large copy
# still in progress is never read half-written. Raise it if you drop very
# large files over a slow network share.
DROPZONE_STABLE_SECONDS=15

# ── CORS (advanced) ───────────────────────────────────────────────────────────
# In the standard Docker Compose setup nginx proxies all requests through the
# same origin, so CORS is not required. Leave this as-is unless you access the
# FastAPI backend directly from another origin.
# Comma-separated list of allowed origins:
CORS_ORIGINS=http://localhost
